# ============================================================
#  RAG Platform — environment configuration
#  Copy to `.env` and fill in. Only the *_KEY values are secret.
# ============================================================

# --- App ---
APP_ENV=development          # development | production
APP_DEBUG=true
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Security (JWT) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# --- Database (Neon free tier, pgvector enabled) ---
# Local docker default below; swap for your Neon connection string in prod.
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag

# --- LLM providers ---
# Embeddings come from Gemini. Generation fails over OpenAI -> Groq -> Gemini.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# Generation failover chain: PRIMARY serves first, then SECONDARY, then TERTIARY.
# Each is one of: openai | groq | gemini | ollama. A stage whose API key is unset
# is skipped automatically. For a fully local, key-free setup, set all to ollama.
GENERATION_PRIMARY=openai
GENERATION_SECONDARY=gemini
GENERATION_TERTIARY=groq
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible gateway (Azure, OpenRouter, ...).
OPENAI_BASE_URL=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama (no API key, no quota). Install from https://ollama.com, then:
#   ollama pull qwen2.5
# Used only when a GENERATION_* stage references "ollama".
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# --- Answer grounding ---
# Sampling temperature for every generation backend. These are grounded,
# retrieval-backed answers, so this is low on purpose — the providers' own
# default of 1.0 is what makes a bot paraphrase its sources into details they
# never contained. Raise it only if replies start reading stilted.
LLM_TEMPERATURE=0.2
# Minimum cosine similarity a retrieved chunk needs before the model is allowed
# to treat it as reference material. Keep it low: scores from
# gemini-embedding-001 rarely clear 0.65, and a high floor empties the context
# entirely (which makes hallucination worse, not better). Most of the filtering
# is done by the scale-free relative cut in src/domain/chat/relevance.py.
RETRIEVAL_MIN_SCORE_FLOOR=0.15

# --- Object storage (Cloudflare R2, S3-compatible) ---
# Leave R2_* blank in local dev to fall back to local-disk storage.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rag-uploads
LOCAL_STORAGE_DIR=.uploads

# --- Public widget / embedding ---
# Where third-party pages load /widget.js and call /api/v1/public/* from.
# Leave blank to fall back to APP_BASE_URL.
WIDGET_BASE_URL=
# Origin hosting the SPA; the share-by-link page lives at <base>/c/<key>.
# Leave blank to fall back to APP_BASE_URL.
FRONTEND_BASE_URL=
# Anonymous abuse guard: max messages per visitor IP per chatbot, per window.
PUBLIC_ANON_MAX_MESSAGES=20
PUBLIC_ANON_WINDOW_SECONDS=600

# --- Scale / concurrency -----------------------------------------------------
# These govern how much simultaneous traffic one process absorbs before it
# starts shedding load. Defaults suit a small instance; raise them together
# with the plan, not individually.
#
# Uvicorn worker processes. Safe to raise above 1 — the follow-up sweep takes a
# Postgres advisory lock so only one worker sweeps per tick. The hard ceiling is
# WEB_CONCURRENCY * (DB_POOL_SIZE + DB_MAX_OVERFLOW) < your database's max
# connections.
WEB_CONCURRENCY=1

# Database connection pool, per worker. Every in-flight request holds one
# connection for its whole transaction, so this is the main limit on concurrent
# requests. Neon/Supabase free tiers cap connections low.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Fail fast instead of queueing behind a saturated pool: a request that waits
# 30s has usually been retried by the client already, which only adds load.
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300

# Generation failover under load. A rate-limited provider is skipped
# immediately rather than retried, so simultaneous requests spread across the
# OpenAI/Groq/Gemini accounts configured above instead of queueing on one.
# After this many consecutive provider-level failures a backend is taken out of
# rotation for the cooldown, then probed with a single request.
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN_SECONDS=30
# In-flight calls allowed per provider, per worker. This is what keeps a burst
# inside each account's quota rather than provoking the 429s the failover chain
# exists to route around. Raise for a paid account, lower for a free tier.
LLM_MAX_CONCURRENCY_PER_PROVIDER=16
# Embeddings run on every retrieval, so this is the busiest external call.
EMBEDDING_MAX_CONCURRENCY=8
# WhatsApp auto-replies generated at once. Inbound arrives in bursts (a campaign
# to 500 contacts replies within seconds), and each reply is a full RAG pipeline
# holding a database connection. Queued work is paced, never dropped.
WHATSAPP_REPLY_MAX_CONCURRENCY=8

# --- Limits / quotas (protect shared free-tier rate limits) ---
MAX_UPLOAD_MB=100
TENANT_DAILY_TOKEN_QUOTA=200000
TENANT_MAX_DOCUMENTS=200
RETRIEVAL_TOP_K=5

# --- Agent (multi-step tool-using endpoint) ---
AGENT_MAX_STEPS=6
AGENT_MAX_REQUESTS=30
AGENT_WINDOW_SECONDS=60

# --- Google OAuth ---------------------------------------------------------
# ONE OAuth client covers all three Google features: "Sign in with Google" on
# the login page, Connect Google Calendar, and Connect Google Sheets. They are
# the same Google Cloud project and differ only in the scopes each requests.
#
# Google Cloud Console -> APIs & Services:
#   1. Library    -> enable Google Calendar API, Google Sheets API, Google Drive
#                    API (Drive is required by the `drive.file` scope Sheets uses)
#   2. OAuth consent screen -> add yourself under Test users while in Testing,
#                    or nobody else can consent
#   3. Credentials -> Create OAuth client ID -> Web application, and register
#                    these redirect URIs exactly (no trailing slash), swapping in
#                    your APP_BASE_URL:
#        http://localhost:8000/api/v1/auth/google/callback
#        http://localhost:8000/api/v1/integrations/oauth/google_calendar/callback
#        http://localhost:8000/api/v1/integrations/oauth/google_sheets/callback
#        http://localhost:8000/api/v1/integrations/google/callback   (legacy)
#
# Blank = the Google button is hidden on the login page and both integration
# cards read "not configured". Nothing else is affected.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Cal.com OAuth (optional) ---
# Cal.com only issues OAuth clients to its Platform customers, so unlike Google
# this cannot be set up from public docs alone: you register a client in the
# Cal.com Platform dashboard and it gives you the endpoints for your instance.
# Blank = the Cal.com card explains what is missing instead of offering Connect.
# Redirect URI to register:
#   <APP_BASE_URL>/api/v1/integrations/oauth/cal_com/callback
CAL_COM_CLIENT_ID=
CAL_COM_CLIENT_SECRET=
CAL_COM_AUTHORIZE_URL=
CAL_COM_TOKEN_URL=

# --- Virtual Interview: Resend (candidate invite email, optional) ---
# Blank = scheduling an interview skips sending email; the admin gets a
# copyable link instead. Free tier at resend.com (3,000 emails/month).
RESEND_API_KEY=
RESEND_FROM_EMAIL=interviews@example.com

# --- AI observability (all optional; default = no tracing) ---
# Langfuse: LLM-native traces/generations/scores. Get keys at cloud.langfuse.com.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=                     # blank = Langfuse Cloud
# OpenTelemetry: system-level spans (configure your own OTLP exporter/collector).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=rag-platform

# ============================================================
#  PRODUCTION (free deploy) — what to change from the defaults
# ============================================================
# APP_ENV=production         # enforces a strong JWT_SECRET at boot
# APP_DEBUG=false
# JWT_SECRET=<48+ random chars>   # python -c "import secrets;print(secrets.token_urlsafe(48))"
# DATABASE_URL=postgresql://USER:PASS@HOST/DB?sslmode=require   # Neon — sslmode is
#   handled automatically (stripped for asyncpg, TLS reapplied via connect_args).
# APP_BASE_URL=https://<your-app>.onrender.com
# Object storage is optional: leave R2_* blank to use local disk (ephemeral on
# free hosts — uploaded files are lost on redeploy, but ingested chunks persist
# in Postgres and stay searchable). Set R2_* for durable uploads.

# --- Voice cloning (optional) ---
# Blank = the Clone Voice page still records, validates, stores, and plays back
# samples; only the cloning step is unavailable and the UI says so.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
VOICE_SAMPLE_MIN_SECONDS=20
VOICE_SAMPLE_MAX_SECONDS=300
VOICE_SAMPLE_MAX_MB=25

# --- Report Issue (optional) ---
# Where submissions are emailed. Needs RESEND_API_KEY too. Blank = reports are
# still saved and listed in the app, just not emailed out.
SUPPORT_EMAIL=

# --- Personal WhatsApp linking, "Phone WhatsApp" (optional) ---
# Shared secret between the API and the Node whatsapp-bridge sidecar. Blank =
# the feature is off, the Channels card is disabled, and nothing else changes.
# The bridge refuses to start without one. Generate: openssl rand -hex 32
#
# NOTE: this links a PERSONAL WhatsApp account via the unofficial multi-device
# protocol. That is against Meta's terms and the number can be banned. Use a
# number you can afford to lose; official Business numbers go through Twilio.
BRIDGE_TOKEN=
BRIDGE_BASE_URL=http://127.0.0.1:8081

# --- WhatsApp Cloud API (Meta business numbers) -----------------------------
#
# The official Business API. Per-number credentials (phone number ID, WABA ID,
# access token) are entered per tenant on the Channels page and stored on the
# channel row -- they are NOT set here, because each tenant brings their own
# number.
#
# These three belong to the Meta *app* that fronts all of them:
#
#   APP SECRET     App Dashboard -> Settings -> Basic -> App Secret.
#                  Meta signs every webhook delivery with it. Blank means the
#                  Cloud webhook refuses everything -- deliberately, since the
#                  endpoint is public and unsigned posts would let anyone put
#                  words in a customer's thread.
#   VERIFY TOKEN   Any string you choose. Paste the same value into
#                  App Dashboard -> WhatsApp -> Configuration -> Verify token.
#                  Only used for the one-time subscription handshake.
#   API VERSION    Pinned on purpose: Meta deprecates versions on a schedule,
#                  and a floating version changes payloads without a deploy.
#
# Callback URL to register with Meta (must be public HTTPS -- use ngrok or
# cloudflared locally, Meta will not call localhost):
#   <APP_BASE_URL>/api/v1/whatsapp/cloud/webhook
# Subscribe the WABA to the "messages" field, or nothing is ever delivered.
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=
WHATSAPP_CLOUD_API_VERSION=v21.0
